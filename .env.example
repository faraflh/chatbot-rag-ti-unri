# Konfigurasi LLM Backend
# Pilih salah satu: "hf_local" atau "openai_compat"
LLM_BACKEND=hf_local

# === Konfigurasi untuk LLM_BACKEND=hf_local ===
# Model HuggingFace (default: SeaLLM-7B-v2 sesuai notebook asli)
HF_MODEL_ID=SeaLLMs/SeaLLM-7B-v2
# Aktifkan 4-bit quantization (butuh CUDA + bitsandbytes)
HF_LOAD_IN_4BIT=true
# Max new tokens per generate
HF_MAX_NEW_TOKENS=300
# Sampling temperature
HF_TEMPERATURE=0.1

# === Konfigurasi untuk LLM_BACKEND=openai_compat ===
# Bisa dipakai dengan: LM Studio (lokal), Ollama, Groq, OpenRouter, Together AI, dll.
# Contoh untuk LM Studio lokal:
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=lm-studio
# Contoh untuk Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.1

# === Path ===
DATA_DIR=data
CHROMA_DIR=chroma_db
COLLECTION_NAME=akademik_ti
EMBEDDING_MODEL=LazarusNLP/all-indo-e5-small-v4
